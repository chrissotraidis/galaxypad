@@ -158,3 +162,7 @@
         // triggered so that we'll skip the next waiting call quite fast.
+        if (notification_observer)
+          notification_observer(observer_context, true);
         m_done_event.Set();
+        if (notification_observer)
+          notification_observer(observer_context, false);
