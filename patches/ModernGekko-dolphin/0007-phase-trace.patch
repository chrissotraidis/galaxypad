+inline std::atomic<std::uint64_t> s_phase_trace_ordinal{};
+
+inline std::FILE* GetPhaseTraceFile()
+{
+  static std::FILE* const file = [] {
+    const char* path = std::getenv("GALAXYPAD_PHASE_TRACE");
+    if (!path || !*path)
+      return static_cast<std::FILE*>(nullptr);
+    std::FILE* opened = std::fopen(path, "w");
+    if (opened)
+    {
+      std::fprintf(opened, "ordinal,steady_ns,event,value\n");
+      std::setvbuf(opened, nullptr, _IOLBF, 0);
+    }
+    return opened;
+  }();
+  return file;
+}
+
+inline void RecordPhase(const char* event, std::uint64_t value = 0)
+{
+  std::FILE* trace = GetPhaseTraceFile();
+  if (!trace)
+    return;
+
+  static std::mutex trace_mutex;
+  const auto now = std::chrono::steady_clock::now().time_since_epoch();
+  const auto now_ns =
+      static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(now).count());
+  const std::uint64_t ordinal = s_phase_trace_ordinal.fetch_add(1, std::memory_order_relaxed);
+  std::lock_guard lock(trace_mutex);
+  std::fprintf(trace, "%llu,%llu,%s,%llu\n", static_cast<unsigned long long>(ordinal),
+               static_cast<unsigned long long>(now_ns), event,
+               static_cast<unsigned long long>(value));
+}
 
