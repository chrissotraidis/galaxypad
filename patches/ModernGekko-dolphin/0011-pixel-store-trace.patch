+// Bounded, opt-in diagnostic for the exact RMGE01 THP pixel-store hotspot.
+// Runs on the CPU thread; never substitutes for the normal MMU write below.
+void TraceGalaxyPixelStore(u32 pc, u32 ea, u8 size, u32 gqr6, u32 msr)
+{
+  if (pc != 0x80452A2Cu)
+    return;
+  static const bool enabled = [] {
+    const char* value = std::getenv("GALAXYPAD_PIXEL_STORE_TRACE");
+    return value && value[0] == '1' && value[1] == '\0';
+  }();
+  static unsigned count = 0;
+  if (!enabled || count >= 16)
+    return;
+  ++count;
+  std::fprintf(stderr,
+               "[galaxypad-pixel-store] sample=%u pc=%08x ea=%08x size=%u gqr6=%08x msr=%08x\n",
+               count, pc, ea, size, gqr6, msr);
+}
 }
 
