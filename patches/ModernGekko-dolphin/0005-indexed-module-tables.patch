+def parse_u32_array(header: str, name: str) -> list[int]:
+    """Return hexadecimal u32 values from one generated lookup table."""
+    match = re.search(
+        rf"static const u32\s+{re.escape(name)}\[[^\]]+\][^=]*=\s*\{{(.*?)\}};",
+        header,
+        re.DOTALL,
+    )
+    if not match:
+        return []
+    return [int(value, 16) for value in re.findall(r"0x([0-9A-Fa-f]+)u", match.group(1))]
+
+
 def main() -> int:
