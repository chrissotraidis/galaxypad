+    # Indexed dispatch emits explicit run boundaries instead of address-guard
+    # expressions. Keep ABI coverage derived from the generated dispatcher,
+    # just as for the linear form, and reject partial/mismatched metadata.
+    indexed_starts = parse_u32_array(header, "dolrecomp_run_start")
+    indexed_ends = parse_u32_array(header, "dolrecomp_run_end")
+    if indexed_starts or indexed_ends:
