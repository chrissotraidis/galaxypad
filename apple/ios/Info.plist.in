<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>GalaxyPad</string>
<key>CFBundleIdentifier</key><string>org.galaxypad.GalaxyPad</string>
<key>CFBundleName</key><string>GalaxyPad</string>
<key>LSApplicationCategoryType</key><string>public.app-category.adventure-games</string>
<key>LSSupportsGameMode</key><true/>
<!-- Compatibility with systems using the earlier Game Mode key. -->
<key>GCSupportsGameMode</key><true/>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.1.0</string>
<key>CFBundleVersion</key><string>4</string>
<key>LSRequiresIPhoneOS</key><true/>
<key>UIFileSharingEnabled</key><true/>
<key>LSSupportsOpeningDocumentsInPlace</key><true/>
<key>MinimumOSVersion</key><string>16.0</string>
<key>UIDeviceFamily</key><array><integer>1</integer><integer>2</integer></array>
<key>UIRequiresFullScreen</key><true/>
<key>UIApplicationSceneManifest</key><dict>
<key>UIApplicationSupportsMultipleScenes</key><false/>
<key>UISceneConfigurations</key><dict>
<key>UIWindowSceneSessionRoleApplication</key><array><dict>
<key>UISceneConfigurationName</key><string>GalaxyPad</string>
<key>UISceneDelegateClassName</key><string>GalaxyPadSceneDelegate</string>
</dict></array></dict></dict>
<key>UILaunchScreen</key><dict/>
<key>UIRequiredDeviceCapabilities</key><array><string>arm64</string><string>metal</string></array>
<key>NSMotionUsageDescription</key><string>Use device motion to aim the Star Pointer when Gyro Cursor is enabled.</string>
<key>UISupportedInterfaceOrientations</key><array>
<string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string>
</array>
<key>UISupportedInterfaceOrientations~ipad</key><array>
<string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string>
</array></dict></plist>
